# =============================================================================
# resilient-scraper — Environment Variables
# Copy to `.env` and fill in real values. `.env` is gitignored.
# =============================================================================

# ---- Database --------------------------------------------------------------
DB_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME

# ---- S3 (scraped image storage) --------------------------------------------
S3_BUCKET=
S3_PREFIX=data/xiaohongshu_images

# ---- Feishu app (login verification notifications, optional) ---------------
# Leave blank to disable Feishu alerts.
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ---- Service tuning --------------------------------------------------------
SCRAPER_API_PORT=18000
SCRAPER_LOG_LEVEL=INFO

# ---- Infrastructure (used by deploy.sh and CDK) ----------------------------
CDK_DEFAULT_ACCOUNT=
CDK_DEFAULT_REGION=us-east-1
VPC_ID=
DB_SG_ID=
RSCRAPER_INSTANCE_TYPE=t3.medium

# ---- Autoscaling (API syncs min/max to the ASG on startup) -----------------
AUTOSCALE_ENABLED=true
AUTOSCALE_ASG_NAME=
AUTOSCALE_MIN_INSTANCES=1
AUTOSCALE_MAX_INSTANCES=5
AUTOSCALE_TASKS_PER_WORKER=5
AUTOSCALE_CHECK_INTERVAL=60
AUTOSCALE_SCALE_DOWN_COOLDOWN=5
